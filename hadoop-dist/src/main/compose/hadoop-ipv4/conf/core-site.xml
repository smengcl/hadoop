<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>

  <!-- hadoop.security.token.service.use_ip is intentionally NOT set here.
       The IPv6 harness forces it to false as a workaround for bracketed
       IPv6 literals in token service strings; on IPv4 the default (true)
       is correct and we want to exercise that code path. -->

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/data/tmp</value>
  </property>
</configuration>
