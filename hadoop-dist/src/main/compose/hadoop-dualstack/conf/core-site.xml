<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>

  <!-- Left at the default (true). On this dual-stack cluster the token
       service id resolves to the peer's preferred (IPv6) address;
       SecurityUtil.buildTokenService bracket-wraps IPv6 literals
       (HADOOP-XXXXX-F2) so it round-trips correctly, exactly as on the
       IPv6-only harness. -->

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/data/tmp</value>
  </property>
</configuration>
