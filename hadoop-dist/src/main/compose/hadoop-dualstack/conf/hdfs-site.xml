<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/dfs/data</value>
  </property>

  <!-- Bind on the IPv6 wildcard. On a dual-stack host with the default
       net.ipv6.bindv6only=0, a [::] socket also accepts IPv4-mapped
       connections, so a single connector serves both stacks. HttpServer2
       dual-stack support (HADOOP-19695) produces the IPv6 connector. -->
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.servicerpc-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>namenode:9870</value>
  </property>

  <!-- DataNodes bind on [::]. Because the JVM prefers IPv6
       (preferIPv6Addresses=true) the xferAddr advertised to the NN is the
       bracketed IPv6 form even though an IPv4 address is also present -
       the load-bearing dual-stack assertion in smoketest.sh. -->
  <property>
    <name>dfs.datanode.address</name>
    <value>[::]:9866</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>[::]:9864</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>[::]:9867</value>
  </property>

  <!-- IP-direct mode (defaults): the client connects to the DN's numeric
       bracketed IPv6 xferAddr, exercising the bracket-aware
       NetUtils.createSocketAddr (HADOOP-17543). Registration hostname check
       is left at its default (true); canonicalizeAddress (HADOOP-XXXXX-F3)
       makes the numeric-IPv6 registration pass. -->

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
