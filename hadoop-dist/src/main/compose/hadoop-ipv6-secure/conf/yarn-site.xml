<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>resourcemanager</value>
  </property>
  <!-- Bind on the IPv6 wildcard; advertise hostname-addressed endpoints. -->
  <property>
    <name>yarn.resourcemanager.bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>yarn.nodemanager.bind-host</name>
    <value>::</value>
  </property>

  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>

  <!-- Serve the RM/NM web UIs over TLS only; the SPNEGO filter in core-site.xml
       adds Kerberos web auth. TLS material is in ssl-server.xml. -->
  <property>
    <name>yarn.http.policy</name>
    <value>HTTPS_ONLY</value>
  </property>

  <!-- DefaultContainerExecutor runs containers as the NodeManager user. It
       works under Kerberos and avoids LinuxContainerExecutor's root/setuid/
       cgroup requirements, which are impractical in this container harness. -->
  <property>
    <name>yarn.nodemanager.container-executor.class</name>
    <value>org.apache.hadoop.yarn.server.nodemanager.DefaultContainerExecutor</value>
  </property>

  <!-- Give WordCount room and skip the vmem check (JVM virtual memory on the
       container base image trips the default limit). -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>4096</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

  <!-- ==== Kerberos ==== -->
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>yarn/_HOST@IPV6.TEST</value>
  </property>
  <property>
    <name>yarn.resourcemanager.keytab</name>
    <value>/keytabs/hadoop.keytab</value>
  </property>
  <property>
    <name>yarn.nodemanager.principal</name>
    <value>yarn/_HOST@IPV6.TEST</value>
  </property>
  <property>
    <name>yarn.nodemanager.keytab</name>
    <value>/keytabs/hadoop.keytab</value>
  </property>

  <!-- When an RPC client validates the server's advertised Kerberos principal,
       it otherwise reverse-resolves the server IP to fill in _HOST. Docker's
       embedded DNS gives a synthetic PTR name (container-N.<proj>_v6net) that
       does not match the "resourcemanager"/"nodemanager-1" the daemons log in
       as, so validation fails. HDFS ships dfs.namenode.kerberos.principal.
       pattern=* by default for exactly this load-balancer/multi-name case;
       YARN has no such default, so set it here. Accepts the advertised
       principal by glob instead of by reverse-DNS equality. -->
  <property>
    <name>yarn.resourcemanager.principal.pattern</name>
    <value>*</value>
  </property>
  <property>
    <name>yarn.nodemanager.principal.pattern</name>
    <value>*</value>
  </property>
</configuration>
