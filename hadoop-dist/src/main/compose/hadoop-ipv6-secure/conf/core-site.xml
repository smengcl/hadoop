<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>

  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <!-- Authentication (Kerberos) is what we exercise over IPv6. Service-level
       authorization is left OFF here because its per-protocol client-principal
       ACL check reverse-resolves the peer IP to build the expected principal,
       and Docker's embedded DNS is asymmetric: forward "datanode-1" -> fd00::21
       but reverse fd00::21 -> "hadoop-ipv6-secure-datanode-1-1.<proj>_v6net".
       That forward/reverse mismatch (identical on IPv4) would reject the DN's
       hdfs/datanode-1 principal. A real deployment with consistent PTR records
       can enable this; it is not an IPv6 concern. -->
  <property>
    <name>hadoop.security.authorization</name>
    <value>false</value>
  </property>
  <!-- Exercise the SASL-negotiated RPC path over IPv6. -->
  <property>
    <name>hadoop.rpc.protection</name>
    <value>authentication</value>
  </property>

  <!-- Map every service/host@IPV6.TEST and user@IPV6.TEST principal to its
       first component (hdfs, yarn, mapred, HTTP, ...). So hdfs/namenode maps
       to the "hdfs" superuser. -->
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>
      RULE:[2:$1@$0](.*@IPV6\.TEST)s/@.*//
      RULE:[1:$1@$0](.*@IPV6\.TEST)s/@.*//
      DEFAULT
    </value>
  </property>

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/data/tmp</value>
  </property>

  <!-- ==== SPNEGO web authentication ==== -->
  <!-- Install the Kerberos SPNEGO authentication filter on every daemon web
       server (NameNode, DataNode, ResourceManager, NodeManager, JobHistory).
       Combined with dfs.http.policy / yarn.http.policy = HTTPS_ONLY this makes
       the whole web plane SPNEGO-authenticated over TLS on IPv6. Without the
       filter these consoles (e.g. /jmx) are reachable unauthenticated. -->
  <property>
    <name>hadoop.http.filter.initializers</name>
    <value>org.apache.hadoop.security.AuthenticationFilterInitializer</value>
  </property>
  <property>
    <name>hadoop.http.authentication.type</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.http.authentication.kerberos.principal</name>
    <value>HTTP/_HOST@IPV6.TEST</value>
  </property>
  <property>
    <name>hadoop.http.authentication.kerberos.keytab</name>
    <value>/keytabs/hadoop.keytab</value>
  </property>
  <!-- Shared secret used to sign the SPNEGO auth cookie; must be identical on
       every daemon. Generated into the image by the Dockerfile. -->
  <property>
    <name>hadoop.http.authentication.signature.secret.file</name>
    <value>/opt/hadoop/etc/hadoop/http-secret</value>
  </property>
  <!-- With type=kerberos the SPNEGO handler already rejects un-negotiated
       requests with HTTP 401; no anonymous-access toggle is needed (that knob
       only applies to type=simple). -->
</configuration>
