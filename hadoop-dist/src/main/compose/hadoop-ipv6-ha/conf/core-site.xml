<configuration>
  <!-- Logical (nameservice) URI; ConfiguredFailoverProxyProvider resolves it
       to whichever NameNode is currently active. -->
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://ns1</value>
  </property>

  <!-- ZooKeeper ensemble for ZKFC automatic failover, reached over IPv6 by
       its AAAA-resolved hostname. -->
  <property>
    <name>ha.zookeeper.quorum</name>
    <value>zookeeper:2181</value>
  </property>

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/data/tmp</value>
  </property>
</configuration>
