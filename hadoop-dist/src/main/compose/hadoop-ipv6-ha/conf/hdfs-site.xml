<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/dfs/data</value>
  </property>

  <!-- ==== HA nameservice ns1 with two NameNodes ==== -->
  <property>
    <name>dfs.nameservices</name>
    <value>ns1</value>
  </property>
  <property>
    <name>dfs.ha.namenodes.ns1</name>
    <value>nn1,nn2</value>
  </property>

  <!-- Per-NameNode RPC/HTTP endpoints, addressed by forward-resolvable
       (AAAA) hostnames; the daemons bind the IPv6 wildcard. -->
  <property>
    <name>dfs.namenode.rpc-address.ns1.nn1</name>
    <value>namenode-1:8020</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.ns1.nn2</name>
    <value>namenode-2:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.ns1.nn1</name>
    <value>namenode-1:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.ns1.nn2</name>
    <value>namenode-2:9870</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>::</value>
  </property>

  <!-- ==== Quorum Journal Manager: shared edits over three JournalNodes ====
       The qjournal authority is a ';'-separated host:port list; IPv6 literals
       would need bracketing, but here the JournalNodes are AAAA-resolved
       hostnames. Each JournalNode binds the IPv6 wildcard. -->
  <property>
    <name>dfs.namenode.shared.edits.dir</name>
    <value>qjournal://journalnode-1:8485;journalnode-2:8485;journalnode-3:8485/ns1</value>
  </property>
  <property>
    <name>dfs.journalnode.edits.dir</name>
    <value>/data/dfs/journal</value>
  </property>
  <property>
    <name>dfs.journalnode.rpc-address</name>
    <value>[::]:8485</value>
  </property>
  <property>
    <name>dfs.journalnode.http-address</name>
    <value>[::]:8480</value>
  </property>

  <!-- ==== Client failover + ZKFC automatic failover ==== -->
  <property>
    <name>dfs.client.failover.proxy.provider.ns1</name>
    <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  </property>
  <property>
    <name>dfs.ha.automatic-failover.enabled</name>
    <value>true</value>
  </property>
  <!-- QJM's epoch-based fencing is the real split-brain guard; the configured
       fencer is a required fallback, and shell(/bin/true) always "succeeds"
       (the failed-over-from node is already dead when we stop its container). -->
  <property>
    <name>dfs.ha.fencing.methods</name>
    <value>shell(/bin/true)</value>
  </property>

  <!-- DataNodes bind the IPv6 wildcard and, in IP-direct mode (the defaults for
       dfs.client/datanode.use.datanode.hostname), advertise a bracketed numeric
       IPv6 xferAddr - exercising the bracket-aware data path under HA. -->
  <property>
    <name>dfs.datanode.address</name>
    <value>[::]:9866</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>[::]:9864</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>[::]:9867</value>
  </property>

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
