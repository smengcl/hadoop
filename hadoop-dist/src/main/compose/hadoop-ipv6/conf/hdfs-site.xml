<configuration>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/dfs/data</value>
  </property>

  <!-- Bind on the IPv6 wildcard. HttpServer2 dual-stack support
       (HADOOP-19695) iterates getAllByName, so binding here on [::]
       produces an IPv6 connector. -->
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.servicerpc-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>::</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>namenode:9870</value>
  </property>

  <!-- DataNodes likewise bind on [::]; xferAddr advertised to the NN
       will be the bracketed IPv6 form once HADOOP-17543 lands. -->
  <property>
    <name>dfs.datanode.address</name>
    <value>[::]:9866</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>[::]:9864</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>[::]:9867</value>
  </property>

  <!-- IP-direct mode is the DEFAULT here (HADOOP-XXXXX-F7): both
       dfs.client.use.datanode.hostname and dfs.datanode.use.datanode.hostname
       are left at their false defaults, so the client connects to the DN's
       numeric bracketed IPv6 xferAddr and the whole data path exercises the
       bracket-aware NetUtils.createSocketAddr (HADOOP-17543) and
       DataTransferSaslUtil.getPeerAddress. The earlier hostname-mode crutch
       has been removed now that F5/F7 make the numeric path work end-to-end.

       The DataNode registers with a numeric IPv6 literal as its reported
       "hostname"; DatanodeManager.canonicalizeAddress (HADOOP-XXXXX-F3)
       normalizes it so the default registration hostname check passes.
       We therefore leave dfs.namenode.datanode.registration.ip-hostname-check
       at its default (true) rather than disabling it. -->

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

  <!-- Decommission exclude list, used by the expanded smoke test to exercise
       node administration over IPv6 (writing a DataNode's numeric IPv6 address
       into this file and running `dfsadmin -refreshNodes`). entrypoint.sh
       creates it empty so refreshNodes always has a file to read. -->
  <property>
    <name>dfs.hosts.exclude</name>
    <value>/opt/hadoop/etc/hadoop/dfs.hosts.exclude</value>
  </property>
</configuration>
