<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>

  <!-- Token-service strings on numeric IPv6 are messy; use hostnames so
       AAAA-resolution stays the source of truth. Tracked as a follow-up
       (SecurityUtil.buildTokenService should bracket-wrap IPv6 IPs). -->
  <property>
    <name>hadoop.security.token.service.use_ip</name>
    <value>false</value>
  </property>

  <property>
    <name>hadoop.tmp.dir</name>
    <value>/data/tmp</value>
  </property>
</configuration>
